# Java / Maven
target/
*.class
*.jar
*.war

# Node
node_modules/
dist/
dist-ssr/
*.local

# Vitest coverage report (backlog #247) — regenerated by every
# `npm run test:coverage` run; never committed.
coverage/

# Env / OS
.env
.env.*
!.env.example
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.iml

# tsc -b emit artifacts
vite.config.js
vite.config.d.ts

# Playwright (backlog #181)
frontend/test-results/
frontend/playwright-report/

# Exported OpenAPI document for the API drift gate (backlog #205) —
# a build artifact re-exported from the controllers on every gate run,
# never committed (a committed copy would go stale silently).
frontend/openapi.json

# k6 load-smoke summary (backlog #224) — written by the CI load-smoke
# job and uploaded as an artifact; never committed (the docs entry in
# docs/load-smoke.md is the record, not a per-run JSON file).
load/k6-summary.json

# Compose-stack backups (backlog #225) — database dumps that include
# password hashes; written by scripts/backup.sh, never committed.
backups/

# Stryker mutation reports + temp dir (backlog #252) — regenerated by
# every `npm run test:mutation` run; never committed (the docs entry in
# docs/mutation-frontend.md is the record, not a per-run JSON file).
.stryker-tmp/
frontend/reports/
